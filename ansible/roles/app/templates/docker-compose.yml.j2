services:
  api:
    build:
      context: {{ app_dir }}/app   
    image: dataproc-api:1.0
    user: "{{ dataproc_uid }}:{{ dataproc_uid }}"  
    expose:
      - "5000"             
    restart: unless-stopped
    networks: [dataproc]

  proxy:
    image: nginx:1.27-alpine
    depends_on: [api]
    ports:
      - "8080:80"          
    volumes:
      - {{ app_dir }}/nginx.conf:/etc/nginx/nginx.conf:ro
      - /var/log/nginx/custom-access.log:/var/log/nginx/custom-access.log
    restart: unless-stopped
    networks: [dataproc]

networks:
  dataproc:
    driver: bridge
